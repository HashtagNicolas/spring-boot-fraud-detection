<?xml version="1.0" encoding="UTF-8"?>
<!--
    Squelette du projet "détection de fraude en temps réel".

    Architecture : une API REST enregistre des transactions bancaires,
    les publie sur un topic Kafka ("transactions"), et des consommateurs
    (à implémenter par la suite) analysent le flux pour détecter des
    fraudes et publier des alertes sur le topic "fraud-alerts".
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot fournit le parent POM qui gère les versions de toutes
         les dépendances Spring (et de beaucoup de librairies tierces) via
         son BOM (Bill Of Materials). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- cherche le parent dans le dépôt Maven, pas sur le disque -->
    </parent>

    <groupId>com.hashtag.ngo.example</groupId>
    <artifactId>fraud-detection</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>fraud-detection</name>
    <description>Détection de fraude en temps réel basée sur Kafka (squelette)</description>

    <properties>
        <!-- Version du JDK utilisée pour la compilation et l'exécution -->
        <java.version>25</java.version>

        <!-- Cucumber et ArchUnit ne sont pas gérés par le BOM Spring Boot,
             leurs versions doivent donc être précisées explicitement. -->
        <cucumber.version>7.20.1</cucumber.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <dependencies>
        <!-- API REST (contrôleurs, sérialisation JSON des requêtes/réponses) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Kafka Spring : starter (auto-configuration) + client producteur/consommateur.
             En Spring Boot 4, l'auto-configuration Kafka vit dans un module séparé
             (spring-boot-kafka) ; ce starter l'apporte, ainsi que spring-kafka. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Endpoints de supervision (santé, métriques...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator) : valide les DTO d'entrée
             de l'API REST (ex. TransactionRequest) via les annotations
             jakarta.validation (@NotBlank, @Positive...) et @Valid. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Jackson : sérialisation/désérialisation JSON des événements Kafka
             (transactions, alertes de fraude). Déjà apporté transitivement par
             spring-boot-starter-web, mais déclaré explicitement car il est
             utilisé directement par les (dé)sérialiseurs Kafka. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Module Jackson pour les types java.time (Instant...), requis par le
             (dé)sérialiseur JSON de Spring Kafka pour l'horodatage des transactions. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Persistance JPA, utilisée pour enregistrer les cas de fraude détectés -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Base de données embarquée H2, utilisée en développement/test pour
             stocker les alertes de fraude sans dépendance externe -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ===================== Dépendances de test ===================== -->

        <!-- Outils de test Spring Kafka : @EmbeddedKafka, utilitaires de
             producteur/consommateur de test -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Support de test MockMvc (@AutoConfigureMockMvc). En Spring Boot 4,
             ce support est un module séparé de spring-boot-starter-test,
             miroir du starter web principal (spring-boot-starter-webmvc). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Socle de test Spring Boot (JUnit 5, AssertJ, Mockito...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber : définitions d'étapes Java pour les tests BDD -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber : moteur d'exécution basé sur la plateforme JUnit 5 -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Permet de déclarer une classe @Suite JUnit 5 pour lancer les
             scénarios Cucumber (via @IncludeEngines("cucumber")) -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit : vérification automatisée des règles d'architecture
             (respect des couches api / bean / bean.impl / entity...) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Empaquette l'application en jar exécutable -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
